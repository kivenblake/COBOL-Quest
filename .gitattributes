# Ensure native line endings across Windows, macOS, and Linux
* text=auto
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sh      text eol=lf
*.command text eol=lf
*.cob     text eol=lf
*.cpy     text eol=lf
*.dat     text eol=lf

# Binary files
*.exe     binary
*.dll     binary
*.zip     binary
*.gz      binary
